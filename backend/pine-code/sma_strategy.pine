// Simple SMA Strategy
//@version=5
indicator("SMA Strategy", overlay=true)
shortPeriod = 9
longPeriod = 21

shortSma = ta.sma(close, shortPeriod)
longSma = ta.sma(close, longPeriod)

buySignal = ta.crossover(shortSma, longSma)
sellSignal = ta.crossunder(shortSma, longSma)

plot(shortSma, color=color.blue)
plot(longSma, color=color.orange)
